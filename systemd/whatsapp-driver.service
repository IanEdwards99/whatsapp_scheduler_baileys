[Unit]
Description=WhatsApp Driver Server (Baileys)
After=network.target

[Service]
Type=simple
User=iedwards
WorkingDirectory=/home/iedwards/development/whatsapp_driver_baileys
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=30

# Give the process time to shut down gracefully
TimeoutStopSec=300

# Give the RPi 3B+ plenty of time to start up
TimeoutStartSec=infinity

# Auto-restart if memory usage gets too high
# Pi has ~1GB RAM, limit process to 800MB before restart
MemoryMax=800M
MemoryHigh=650M

# Limit restart bursts: max 5 restarts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
