#!/bin/bash
# Stop all WhatsApp Scheduler processes
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"

# Use venv python if available, fallback to system python
if [ -f exec "$DIR/venv/bin/python" ]; then
    exec "$DIR/venv/bin/python" "$DIR/manage.py" stop "$@"
else
    exec python3 "$DIR/manage.py" stop "$@"
fi
